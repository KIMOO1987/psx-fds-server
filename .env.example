# Copy to .env for LOCAL use only, or enter these in Coolify -> Environment Variables.
# NEVER commit the real .env. NEVER put real values in this example file.
ADMIN_USER=admin
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
SECRET_KEY=
# 1 = cookies only over HTTPS (keep 1 in production). Use 0 only for http://localhost testing.
COOKIE_SECURE=1
# Comma-separated browser origins allowed to call the API. Leave empty for the desktop client.
CORS_ORIGINS=
DATA_DIR=/app/data
